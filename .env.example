# Puerto local del servidor
PORT=3000

# MongoDB local. Si usas Atlas, reemplaza esta dirección por tu URI.
MONGO_URI=mongodb://127.0.0.1:27017/nova_salud

# Usa una clave aleatoria propia de al menos 32 caracteres.
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UNA_CADENA_SEGURA_DE_32_CARACTERES

# Datos para crear o restablecer el administrador inicial.
ADMIN_CORREO=admin@novasalud.com
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA
